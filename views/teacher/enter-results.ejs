<h2 class="mb-4">Enter Results</h2>

<% if (typeof currentSession !== 'undefined' && currentSession && typeof currentTerm !== 'undefined' && currentTerm) { %>
  <div class="alert alert-info mb-3">
    <i class="bi bi-calendar3"></i> Current: <strong><%= currentSession.name %></strong> | <strong><%= currentTerm.name %></strong>
  </div>
<% } %>

<% if (teacher && teacher.class_id) { %>
  <div class="alert alert-info">
    <i class="bi bi-info-circle"></i> Entering results for: <strong><%= teacher.class_name %><%= teacher.class_arm ? ' ' + teacher.class_arm : '' %></strong>
  </div>

  <div class="row">
    <div class="col-md-6">
      <div class="card">
        <div class="card-header">Select Student</div>
        <div class="card-body">
          <div class="list-group">
            <% students.forEach(function(s) { %>
              <a href="/teacher/enter-results?student=<%= s.id %>" class="list-group-item list-group-item-action <%= selectedStudent && selectedStudent.id == s.id ? 'active' : '' %>">
                <strong><%= s.reg_no %></strong> - <%= s.first_name %> <%= s.middle_name ? s.middle_name + ' ' : '' %><%= s.last_name %>
              </a>
            <% }) %>
          </div>
          <% if (students.length === 0) { %>
            <p class="text-muted mt-3">No students found in this class.</p>
          <% } %>
        </div>
      </div>
    </div>

    <div class="col-md-6">
      <% if (selectedStudent) { %>
        <div class="card">
          <div class="card-header">Enter Results for <%= selectedStudent.first_name %> <%= selectedStudent.middle_name ? selectedStudent.middle_name + ' ' : '' %><%= selectedStudent.last_name %> (<%= selectedStudent.reg_no %>)</div>
          <div class="card-body">
             <form method="POST" action="/teacher/results" id="resultsForm">
              <input type="hidden" name="student_id" value="<%= selectedStudent.id %>">

              <% studentSubjects.forEach(function(ss) { %>
                <div class="mb-3">
                  <label class="form-label"><strong><%= ss.subject_name %></strong></label>
                  <% if (studentResults && studentResults[ss.subject_id]) { %>
                    <% if (studentResults[ss.subject_id].status === 'rejected') { %>
                      <div class="alert alert-danger">
                        <i class="bi bi-x-circle"></i> Result REJECTED:
                        CA: <%= studentResults[ss.subject_id].ca_score %>,
                        Exam: <%= studentResults[ss.subject_id].exam_score %>,
                        Total: <%= studentResults[ss.subject_id].total %>,
                        Grade: <%= studentResults[ss.subject_id].grade %>
                        <br><small>You can re-upload this result.</small>
                      </div>
                      <div class="row">
                        <div class="col">
                          <input type="number" step="1" class="form-control" name="ca_<%= ss.subject_id %>" placeholder="CA Score (0-30)" min="0" max="30" value="<%= Math.round(studentResults[ss.subject_id].ca_score) %>">
                        </div>
                        <div class="col">
                          <input type="number" step="1" class="form-control" name="exam_<%= ss.subject_id %>" placeholder="Exam Score (0-70)" min="0" max="70" value="<%= Math.round(studentResults[ss.subject_id].exam_score) %>">
                        </div>
                      </div>
                    <% } else { %>
                      <div class="alert alert-success">
                        <i class="bi bi-check-circle"></i> Result already uploaded:
                        CA: <%= studentResults[ss.subject_id].ca_score %>,
                        Exam: <%= studentResults[ss.subject_id].exam_score %>,
                        Total: <%= studentResults[ss.subject_id].total %>,
                        Grade: <%= studentResults[ss.subject_id].grade %>
                        <br><small class="text-muted">Status: <%= studentResults[ss.subject_id].status %></small>
                      </div>
                    <% } %>
                  <% } else { %>
                    <div class="row">
                      <div class="col">
                        <input type="number" step="1" class="form-control" name="ca_<%= ss.subject_id %>" placeholder="CA Score (0-30)" min="0" max="30">
                      </div>
                      <div class="col">
                        <input type="number" step="1" class="form-control" name="exam_<%= ss.subject_id %>" placeholder="Exam Score (0-70)" min="0" max="70">
                      </div>
                    </div>
                  <% } %>
                </div>
              <% }) %>

              <button type="submit" class="btn btn-success w-100">Submit Results</button>
            </form>
          </div>
        </div>
      <% } else { %>
        <div class="card">
          <div class="card-body text-center">
            <i class="bi bi-arrow-left-circle" style="font-size: 3rem; color: #6c757d;"></i>
            <p class="mt-3">Select a student from the left to enter their results.</p>
          </div>
        </div>
      <% } %>
    </div>
  </div>
<% } else { %>
  <div class="alert alert-warning">
    <i class="bi bi-exclamation-triangle"></i> You are not assigned to any class. Please contact the admin.
  </div>
<% } %>
