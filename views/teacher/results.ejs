<h2 class="mb-4">My Uploaded Results</h2>

<% if (typeof currentSession !== 'undefined' && currentSession && typeof currentTerm !== 'undefined' && currentTerm) { %>
  <div class="alert alert-info mb-3">
    <i class="bi bi-calendar3"></i> Showing results for: <strong><%= currentSession.name %></strong> | <strong><%= currentTerm.name %></strong>
  </div>
<% } %>

<% if (typeof success !== 'undefined' && success) { %>
  <div class="alert alert-success"><%= success %></div>
<% } %>

<% if (results.length === 0) { %>
  <div class="card"><div class="card-body text-muted">No results uploaded yet.</div></div>
<% } else { %>
  <div class="accordion" id="resultsAccordion">
    <% results.forEach(function(student, idx) { %>
      <div class="accordion-item">
        <h2 class="accordion-header">
          <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#student-<%= student.student_id %>">
            <i class="bi bi-person-circle me-2"></i>
            <strong><%= student.first_name %> <%= student.middle_name ? student.middle_name + ' ' : '' %><%= student.last_name %></strong>
            <span class="text-muted ms-2">(<%= student.reg_no %>)</span>
            <span class="text-muted ms-2">| <%= student.class_name %><%= student.class_arm ? '-' + student.class_arm : '' %></span>
            <span class="badge bg-secondary ms-auto"><%= student.subjects.length %> subjects</span>
          </button>
        </h2>
        <div id="student-<%= student.student_id %>" class="accordion-collapse collapse" data-bs-parent="#resultsAccordion">
          <div class="accordion-body p-0">
            <table class="table table-sm table-striped mb-0">
              <thead style="background:#2c3e50;color:#fff">
                <tr>
                  <th>Subject</th>
                  <th>CA</th>
                  <th>Exam</th>
                  <th>Total</th>
                  <th>Grade</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% student.subjects.forEach(function(r) { %>
                  <tr>
                    <td><%= r.subject_name %></td>
                    <td><%= r.ca_score %></td>
                    <td><%= r.exam_score %></td>
                    <td><strong><%= r.total %></strong></td>
                    <td><%= r.grade || '--' %></td>
                    <td>
                      <% if (r.status === 'approved') { %>
                        <span class="badge bg-success">Approved</span>
                      <% } else if (r.status === 'rejected') { %>
                        <span class="badge bg-danger">Rejected</span>
                      <% } else { %>
                        <span class="badge bg-warning">Pending</span>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>
