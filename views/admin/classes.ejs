<h2 class="mb-4">Manage Classes</h2>
<div class="row">
  <div class="col-md-4">
    <div class="card">
      <div class="card-header">Add New Class</div>
      <div class="card-body">
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger"><%= error %></div>
        <% } %>
        <form method="POST" action="/admin/classes">
          <div class="mb-3">
            <label for="name" class="form-label">Class</label>
            <select class="form-select" id="name" name="name" required>
              <option value="JSS1">JSS1</option>
              <option value="JSS2">JSS2</option>
              <option value="JSS3">JSS3</option>
              <option value="SS1">SS1</option>
              <option value="SS2">SS2</option>
              <option value="SS3">SS3</option>
            </select>
          </div>
          <div class="mb-3">
            <label for="arm" class="form-label">Arm <small class="text-muted">(optional for Junior classes, required for Senior)</small></label>
            <select class="form-select" id="arm" name="arm">
              <option value="">-- No Arm (Junior) --</option>
              <option value="A">A</option>
              <option value="B">B</option>
              <option value="C">C</option>
            </select>
          </div>
          <button type="submit" class="btn btn-primary w-100">Add Class</button>
        </form>
      </div>
    </div>
  </div>
  <div class="col-md-8">
    <div class="card">
      <div class="card-header">Existing Classes</div>
      <div class="card-body">
        <table class="table table-striped">
          <thead>
            <tr>
              <th>Class</th>
              <th>Arm</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% classes.forEach(function(c) { %>
              <tr>
                <td><%= c.name %></td>
                <td><%= c.arm || '-' %></td>
                <td>
                  <button class="btn btn-sm btn-danger delete-class" data-id="<%= c.id %>">Delete</button>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
        <% if (classes.length === 0) { %>
          <p class="text-muted">No classes found.</p>
        <% } %>
      </div>
    </div>
  </div>
</div>
<script>
  document.querySelectorAll('.delete-class').forEach(btn => {
    btn.addEventListener('click', async function() {
      if (await showConfirm('Delete this class?')) {
        const res = await fetch('/admin/classes/' + this.dataset.id, { method: 'DELETE' });
        if (res.ok) location.reload();
      }
    });
  });
</script>
