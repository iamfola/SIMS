<h2 class="mb-4">Pending Results</h2>

<div class="card mb-4">
  <div class="card-body">
    <form method="GET" action="/admin/results/pending" class="row g-3">
      <div class="col-md-3">
        <label for="session_id" class="form-label">Session</label>
        <select class="form-select" id="session_id" name="session_id">
          <option value="">All Sessions</option>
          <% sessions.forEach(function(s) { %>
            <option value="<%= s.id %>" <%= selectedSessionId == s.id ? 'selected' : '' %>><%= s.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-3">
        <label for="term_id" class="form-label">Term</label>
        <select class="form-select" id="term_id" name="term_id">
          <option value="">All Terms</option>
          <% if (typeof availableTerms !== 'undefined' && availableTerms.length > 0) { %>
            <% availableTerms.forEach(function(t) { %>
              <option value="<%= t.id %>" <%= selectedTermId == t.id ? 'selected' : '' %>><%= t.name %></option>
            <% }) %>
          <% } else if (typeof currentTerm !== 'undefined' && currentTerm) { %>
            <option value="<%= currentTerm.id %>" <%= selectedTermId == currentTerm.id ? 'selected' : '' %>><%= currentTerm.name %></option>
          <% } %>
        </select>
      </div>
      <div class="col-md-6 d-flex align-items-end">
        <button type="submit" class="btn btn-primary">Filter</button>
        <span class="ms-3 text-muted">Active: <%= currentSession ? currentSession.name : 'N/A' %> | <%= currentTerm ? currentTerm.name : 'N/A' %></span>
      </div>
    </form>
  </div>
</div>

<% if (results.length === 0) { %>
  <div class="card">
    <div class="card-body text-center text-muted py-5">
      <i class="bi bi-check-circle" style="font-size: 3rem;"></i>
      <p class="mt-3">No pending results!</p>
    </div>
  </div>
<% } else { %>
  <div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
      <span><%= results.length %> result(s) pending approval</span>
      <div>
        <button class="btn btn-sm btn-success approve-all-btn d-none" id="approveAllBtn">
          <i class="bi bi-check-all"></i> Approve Selected (<span id="selectedCount">0</span>)
        </button>
        <button class="btn btn-sm btn-success approve-all-page-btn">
          <i class="bi bi-check-all"></i> Approve All Page
        </button>
      </div>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th style="width:40px"><input type="checkbox" id="selectAll"></th>
              <th>Student</th>
              <th>Reg No</th>
              <th>Class</th>
              <th>Subject</th>
              <th>CA</th>
              <th>Exam</th>
              <th>Total</th>
              <th>Grade</th>
              <th>Term</th>
              <th>Session</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% results.forEach(function(r) { %>
              <tr data-result-id="<%= r.id %>">
                <td><input type="checkbox" class="result-check" value="<%= r.id %>"></td>
                <td><%= r.first_name %> <%= r.middle_name ? r.middle_name + ' ' : '' %><%= r.last_name %></td>
                <td><strong><%= r.reg_no %></strong></td>
                <td><%= r.class_name %><%= r.class_arm ? ' ' + r.class_arm : '' %></td>
                <td><%= r.subject_name %></td>
                <td><%= r.ca_score %></td>
                <td><%= r.exam_score %></td>
                <td><strong><%= r.total %></strong></td>
                <td><%= r.grade %></td>
                <td><%= r.term %></td>
                <td><%= r.session %></td>
                <td>
                  <button class="btn btn-sm btn-success approve-btn" data-id="<%= r.id %>">Approve</button>
                  <button class="btn btn-sm btn-danger reject-btn" data-id="<%= r.id %>">Reject</button>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
<% } %>

<script>
  function getSelectedIds() {
    return Array.from(document.querySelectorAll('.result-check:checked')).map(cb => cb.value);
  }
  function updateApproveAllBtn() {
    const ids = getSelectedIds();
    const btn = document.getElementById('approveAllBtn');
    if (ids.length > 0) {
      btn.classList.remove('d-none');
      document.getElementById('selectedCount').textContent = ids.length;
    } else {
      btn.classList.add('d-none');
    }
  }

  document.querySelectorAll('.result-check').forEach(cb => cb.addEventListener('change', updateApproveAllBtn));
  document.getElementById('selectAll').addEventListener('change', function() {
    document.querySelectorAll('.result-check').forEach(cb => cb.checked = this.checked);
    updateApproveAllBtn();
  });

  document.querySelectorAll('.approve-btn').forEach(btn => {
    btn.addEventListener('click', async function() {
      if (await showConfirm('Approve this result?')) {
        const res = await fetch('/admin/results/' + this.dataset.id + '/approve', { method: 'POST' });
        if (res.ok) location.reload();
      }
    });
  });

  document.querySelectorAll('.reject-btn').forEach(btn => {
    btn.addEventListener('click', async function() {
      if (await showConfirm('Reject this result?')) {
        const res = await fetch('/admin/results/' + this.dataset.id + '/reject', { method: 'POST' });
        if (res.ok) location.reload();
      }
    });
  });

  document.querySelector('.approve-all-page-btn').addEventListener('click', async function() {
    const ids = Array.from(document.querySelectorAll('.approve-btn')).map(b => b.dataset.id);
    if (ids.length === 0) return;
    if (await showConfirm('Approve all ' + ids.length + ' results on this page?')) {
      for (const id of ids) {
        await fetch('/admin/results/' + id + '/approve', { method: 'POST' });
      }
      location.reload();
    }
  });

  document.getElementById('approveAllBtn').addEventListener('click', async function() {
    const ids = getSelectedIds();
    if (ids.length === 0) return;
    if (await showConfirm('Approve ' + ids.length + ' selected results?')) {
      for (const id of ids) {
        await fetch('/admin/results/' + id + '/approve', { method: 'POST' });
      }
      location.reload();
    }
  });
</script>