<h2 class="mb-4">Pending Results</h2>

<div class="card mb-4">
  <div class="card-body">
    <form method="GET" action="/admin/results/pending" class="row g-3">
      <div class="col-md-3">
        <label for="session_id" class="form-label">Session</label>
        <select class="form-select" id="session_id" name="session_id">
          <option value="">All Sessions</option>
          <% sessions.forEach(function(s) { %>
            <option value="<%= s.id %>" <%= selectedSessionId == s.id ? 'selected' : '' %>><%= s.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-3">
        <label for="term_id" class="form-label">Term</label>
        <select class="form-select" id="term_id" name="term_id">
          <option value="">All Terms</option>
          <% if (typeof availableTerms !== 'undefined' && availableTerms.length > 0) { %>
            <% availableTerms.forEach(function(t) { %>
              <option value="<%= t.id %>" <%= selectedTermId == t.id ? 'selected' : '' %>><%= t.name %></option>
            <% }) %>
          <% } else if (typeof currentTerm !== 'undefined' && currentTerm) { %>
            <option value="<%= currentTerm.id %>" <%= selectedTermId == currentTerm.id ? 'selected' : '' %>><%= currentTerm.name %></option>
          <% } %>
        </select>
      </div>
      <div class="col-md-6 d-flex align-items-end">
        <button type="submit" class="btn btn-primary">Filter</button>
        <span class="ms-3 text-muted">Active: <%= currentSession ? currentSession.name : 'N/A' %> | <%= currentTerm ? currentTerm.name : 'N/A' %></span>
      </div>
    </form>
  </div>
</div>

<%
  var grouped = {};
  results.forEach(function(r) {
    var key = r.student_id;
    if (!grouped[key]) grouped[key] = { student_id: r.student_id, reg_no: r.reg_no, first_name: r.first_name, last_name: r.last_name, middle_name: r.middle_name, class_name: r.class_name, class_arm: r.class_arm, subjects: [] };
    grouped[key].subjects.push(r);
  });
  var studentIds = Object.keys(grouped);
%>

<% if (results.length === 0) { %>
  <div class="card">
    <div class="card-body text-center text-muted py-5">
      <i class="bi bi-check-circle" style="font-size: 3rem;"></i>
      <p class="mt-3">No pending results!</p>
    </div>
  </div>
<% } else { %>
  <div class="d-flex justify-content-between align-items-center mb-3">
    <span class="text-muted"><%= studentIds.length %> student(s) with <%= results.length %> pending result(s)</span>
    <button class="btn btn-success" id="approveAllStudentsBtn">
      <i class="bi bi-check-all"></i> Approve All Students
    </button>
  </div>

  <% studentIds.forEach(function(key) { %>
    <% var student = grouped[key]; %>
    <div class="card mb-3">
      <div class="card-header d-flex justify-content-between align-items-center">
        <div>
          <strong><%= student.reg_no %></strong> &mdash;
          <%= student.first_name %> <%= student.middle_name ? student.middle_name + ' ' : '' %><%= student.last_name %>
          <span class="badge bg-secondary ms-2"><%= student.class_name %><%= student.class_arm ? ' ' + student.class_arm : '' %></span>
        </div>
        <button class="btn btn-sm btn-success approve-student-btn" data-student-id="<%= student.student_id %>">
          <i class="bi bi-check-all"></i> Approve All (<%= student.subjects.length %>)
        </button>
      </div>
      <div class="card-body p-0">
        <table class="table table-sm mb-0">
          <thead class="table-light">
            <tr>
              <th>Subject</th>
              <th>CA</th>
              <th>Exam</th>
              <th>Total</th>
              <th>Grade</th>
              <th>Term</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% student.subjects.forEach(function(r) { %>
              <tr data-result-id="<%= r.id %>">
                <td><%= r.subject_name %></td>
                <td><%= r.ca_score %></td>
                <td><%= r.exam_score %></td>
                <td><strong><%= r.total %></strong></td>
                <td><%= r.grade %></td>
                <td><%= r.term %></td>
                <td>
                  <button class="btn btn-sm btn-success approve-btn" data-id="<%= r.id %>">Approve</button>
                  <button class="btn btn-sm btn-danger reject-btn" data-id="<%= r.id %>">Reject</button>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  <% }) %>
<% } %>

<script>
  document.querySelectorAll('.approve-btn').forEach(btn => {
    btn.addEventListener('click', async function() {
      if (await showConfirm('Approve this result?')) {
        const res = await fetch('/admin/results/' + this.dataset.id + '/approve', { method: 'POST' });
        if (res.ok) location.reload();
      }
    });
  });

  document.querySelectorAll('.reject-btn').forEach(btn => {
    btn.addEventListener('click', async function() {
      if (await showConfirm('Reject this result?')) {
        const res = await fetch('/admin/results/' + this.dataset.id + '/reject', { method: 'POST' });
        if (res.ok) location.reload();
      }
    });
  });

  document.querySelectorAll('.approve-student-btn').forEach(btn => {
    btn.addEventListener('click', async function() {
      if (await showConfirm('Approve all pending results for this student?')) {
        const res = await fetch('/admin/results/student/' + this.dataset.studentId + '/approve-all', { method: 'POST' });
        if (res.ok) location.reload();
      }
    });
  });

  document.getElementById('approveAllStudentsBtn').addEventListener('click', async function() {
    var ids = <%= JSON.stringify(studentIds.map(Number)) %>;
    if (ids.length === 0) return;
    if (await showConfirm('Approve all pending results for ALL ' + ids.length + ' students?')) {
      for (const sid of ids) {
        await fetch('/admin/results/student/' + sid + '/approve-all', { method: 'POST' });
      }
      location.reload();
    }
  });
</script>