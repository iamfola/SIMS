<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof school !== 'undefined' ? school.school_name : 'SIMS' %> - Login</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
  <% var gf = typeof school !== 'undefined' && school.font_family ? school.font_family : 'Inter'; if (gf !== 'System UI' && gf !== 'Segoe UI') { %>
  <link href="https://fonts.googleapis.com/css2?family=<%= encodeURIComponent(gf) %>:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <% } %>
  <link href="/css/style.css" rel="stylesheet">
  <style>
    :root {
      --primary: <%= typeof school !== 'undefined' ? school.primary_color : '#3b82f6' %>;
      --primary-dark: <%= typeof school !== 'undefined' ? school.primary_color : '#3b82f6' %>;
      --secondary: <%= typeof school !== 'undefined' ? school.secondary_color : '#8b5cf6' %>;
      --accent: <%= typeof school !== 'undefined' ? school.accent_color : '#06b6d4' %>;
      --border-radius: <%= typeof school !== 'undefined' && school.border_radius ? school.border_radius + 'px' : '12px' %>;
      --border-radius-sm: <%= typeof school !== 'undefined' && school.border_radius ? Math.max(4, Math.floor(parseInt(school.border_radius) * 0.6)) + 'px' : '8px' %>;
      --font-family: '<%= gf %>', 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, 'Helvetica Neue', Arial, sans-serif;
    }
    body {
      font-family: var(--font-family);
      background: var(--bg);
    }
    .login-card .login-logo i {
      background: linear-gradient(135deg, var(--primary), var(--secondary));
      -webkit-background-clip: text;
      background-clip: text;
    }
    .btn-primary {
      background: var(--primary);
      border: none;
    }
    .btn-primary:hover {
      background: var(--primary-dark);
    }
  </style>
</head>
<body class="login-bg-<%= typeof school !== 'undefined' && school.login_bg_style ? school.login_bg_style : 'default' %>">
  <div class="login-container">
    <div class="login-card">
      <div class="login-logo">
        <% if (typeof school !== 'undefined' && school.logo_path) { %>
          <img src="<%= school.logo_path %>" alt="Logo" style="max-height: 70px; margin-bottom: 10px;">
        <% } else { %>
          <i class="bi bi-building"></i>
        <% } %>
        <h3><%= typeof school !== 'undefined' ? school.school_name : 'SIMS' %></h3>
        <p>
          <%= typeof school !== 'undefined' && school.school_motto ? school.school_motto : 'School Management System' %>
        </p>
      </div>
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>
      <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success"><%= success %></div>
      <% } %>
      <form method="POST" action="/login">
        <div class="mb-3">
          <label for="username" class="form-label">Username or Reg No</label>
           <input type="text" class="form-control" id="username" name="username" placeholder="Username or Reg No" required autofocus>
        </div>
        <div class="mb-4">
          <label for="password" class="form-label">Password</label>
          <input type="password" class="form-control" id="password" name="password" required>
        </div>
        <button type="submit" class="btn btn-primary w-100">Login</button>
        <div class="text-center mt-3">
          <a href="/forgot-password" class="text-decoration-none small"><i class="bi bi-question-circle"></i> Forgot Password?</a>
        </div>
      </form>
      <% if (typeof school !== 'undefined' && school.login_message) { %>
        <div class="mt-3 p-2 text-center small" style="background:var(--primary-light);color:var(--primary);border-radius:var(--border-radius-sm)">
          <i class="bi bi-info-circle"></i> <%= school.login_message %>
        </div>
      <% } %>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    (function() {
      var theme = localStorage.getItem('sims-theme');
      if (theme === 'dark') {
        document.documentElement.setAttribute('data-bs-theme', 'dark');
      }
    })();
  </script>
</body>
</html>