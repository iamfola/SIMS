<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof school !== 'undefined' ? school.school_name : 'SIMS' %> - Enter Passcode</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
  <style>
    :root {
      --primary: <%= typeof school !== 'undefined' ? school.primary_color : '#3b82f6' %>;
      --primary-dark: <%= typeof school !== 'undefined' ? school.primary_color : '#3b82f6' %>;
      --secondary: <%= typeof school !== 'undefined' ? school.secondary_color : '#8b5cf6' %>;
      --font-family: '<%= typeof school !== 'undefined' && school.font_family ? school.font_family : 'Inter' %>', 'Segoe UI', -apple-system, sans-serif;
    }
    body { background: var(--bg); font-family: var(--font-family); }
  </style>
</head>
<body>
  <div class="login-container">
    <div class="login-card">
      <div class="login-logo">
        <i class="bi bi-key"></i>
        <h3>Set New Password</h3>
        <p><%= typeof school !== 'undefined' ? school.school_name : 'SIMS' %> &mdash; Passcode verified. Choose a new password.</p>
      </div>
            <% if (typeof error !== 'undefined' && error) { %>
              <div class="alert alert-danger"><%= error %></div>
            <% } %>
            <form method="POST" action="/reset-password">
              <input type="hidden" name="username" value="<%= typeof username !== 'undefined' ? username : '' %>">
              <div class="mb-3">
                <label for="newPassword" class="form-label">New Password</label>
                <input type="password" class="form-control" id="newPassword" name="newPassword" minlength="6" required autofocus>
              </div>
              <div class="mb-4">
                <label for="confirmPassword" class="form-label">Confirm New Password</label>
                <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" minlength="6" required>
              </div>
              <button type="submit" class="btn btn-primary w-100">Reset Password</button>
            </form>
            <div class="text-center mt-3">
              <a href="/login" class="text-decoration-none"><i class="bi bi-arrow-left"></i> Back to Login</a>
            </div>
      </div>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    (function() {
      var theme = localStorage.getItem('sims-theme');
      if (theme === 'dark') {
        document.documentElement.setAttribute('data-bs-theme', 'dark');
      }
    })();
  </script>
</body>
</html>