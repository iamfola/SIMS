<div class="row justify-content-center">
  <div class="col-md-6 col-lg-5">
    <div class="card shadow">
      <div class="card-body p-5">
        <h3 class="text-center mb-2">Set Up Your Email</h3>
        <p class="text-muted text-center mb-4">Please provide your email address to receive result notifications</p>
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger"><%= error %></div>
        <% } %>
        <% if (typeof success !== 'undefined' && success) { %>
          <div class="alert alert-success"><%= success %></div>
        <% } %>
        <form method="POST" action="/student/setup-email">
          <div class="mb-3">
            <label for="email" class="form-label">Email Address</label>
            <input type="email" class="form-control" id="email" name="email" required placeholder="Enter your email address">
          </div>
          <button type="submit" class="btn btn-primary w-100">Save Email</button>
        </form>
        <% if (student && student.email) { %>
          <div class="mt-3 text-center">
            <p class="text-muted">Current email: <strong><%= student.email %></strong></p>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>
