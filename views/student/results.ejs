<div class="results-page">
  <div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-2">
    <div>
      <h2 class="page-title mb-1">My Results</h2>
      <p class="page-subtitle mb-0">View your approved academic results</p>
    </div>
  </div>

  <% if (pendingCount > 0) { %>
    <div class="alert alert-warning d-flex align-items-center gap-2 mb-4">
      <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
      <span>You have <strong><%= pendingCount %></strong> result(s) pending approval. Only approved results are shown below.</span>
    </div>
  <% } %>

  <div class="card mb-4">
    <div class="card-body">
      <form method="GET" action="/student/results" class="row g-3">
        <div class="col-md-4">
          <label for="session_id" class="form-label">Academic Session</label>
          <select class="form-select" id="session_id" name="session_id" onchange="this.form.submit()">
            <option value="">All Sessions</option>
            <% allSessions.forEach(function(s) { %>
              <option value="<%= s.id %>" <%= selectedSessionId == s.id ? 'selected' : '' %>><%= s.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-4">
          <label for="term_id" class="form-label">Term</label>
          <select class="form-select" id="term_id" name="term_id" onchange="this.form.submit()">
            <option value="">All Terms</option>
            <% availableTerms.forEach(function(t) { %>
              <option value="<%= t.id %>" <%= selectedTermId == t.id ? 'selected' : '' %>><%= t.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-4 d-flex align-items-end gap-2">
          <button type="submit" class="btn btn-primary flex-fill"><i class="bi bi-filter-left"></i> Filter</button>
          <% if (results.length > 0) { %>
            <button type="button" class="btn btn-outline-success" onclick="downloadResult()" id="downloadBtn" title="Download result PDF">
              <i class="bi bi-download"></i>
            </button>
            <button type="button" class="btn btn-outline-primary" onclick="requestResult()" id="requestBtn" title="Request result PDF via email">
              <i class="bi bi-envelope"></i>
            </button>
          <% } %>
        </div>
      </form>
    </div>
  </div>

  <% if (selectedSession && selectedTerm) { %>
    <div class="alert alert-info d-flex align-items-center gap-2 mb-4">
      <i class="bi bi-calendar3 flex-shrink-0"></i>
      <span>Showing: <strong><%= selectedSession.name %></strong> | <strong><%= selectedTerm.name %></strong></span>
    </div>
  <% } else if (selectedSession) { %>
    <div class="alert alert-info d-flex align-items-center gap-2 mb-4">
      <i class="bi bi-calendar3 flex-shrink-0"></i>
      <span>Showing: <strong><%= selectedSession.name %></strong> | All Terms</span>
    </div>
  <% } %>

  <% if (results.length > 0) { %>
    <%
      var totalScore = 0;
      var totalSubjects = results.length;
      results.forEach(function(r) { totalScore += r.total; });
      var avgScore = (totalScore / totalSubjects).toFixed(1);
      var gpa = results.reduce(function(sum, r) {
        var gp = r.grade === 'A' ? 5 : r.grade === 'B' ? 4 : r.grade === 'C' ? 3 : r.grade === 'D' ? 2 : r.grade === 'E' ? 1 : 0;
        return sum + gp;
      }, 0) / totalSubjects;
    %>

    <div class="row g-3 mb-4">
      <div class="col-4">
        <div class="stat-card bg-primary text-center" style="padding: 16px 8px;">
          <div class="stat-number" style="font-size: 1.5rem;"><%= totalSubjects %></div>
          <div class="stat-label" style="font-size: 0.65rem;">Subjects</div>
        </div>
      </div>
      <div class="col-4">
        <div class="stat-card bg-success text-center" style="padding: 16px 8px;">
          <div class="stat-number" style="font-size: 1.5rem;"><%= avgScore %>%</div>
          <div class="stat-label" style="font-size: 0.65rem;">Average</div>
        </div>
      </div>
      <div class="col-4">
        <div class="stat-card bg-purple text-center" style="padding: 16px 8px;">
          <div class="stat-number" style="font-size: 1.5rem;"><%= gpa.toFixed(1) %></div>
          <div class="stat-label" style="font-size: 0.65rem;">GPA</div>
        </div>
      </div>
    </div>

    <%
      var currentGroup = '';
      var groupedResults = {};
      results.forEach(function(r) {
        var key = (r.session || 'N/A') + '|' + (r.term || 'N/A');
        if (!groupedResults[key]) groupedResults[key] = [];
        groupedResults[key].push(r);
      });
    %>

    <% for (var groupKey in groupedResults) {
      var group = groupKey.split('|');
      var sessionName = group[0];
      var termName = group[1];
      var groupResults = groupedResults[groupKey];
      var groupTotal = 0;
      groupResults.forEach(function(r) { groupTotal += r.total; });
      var groupAvg = (groupTotal / groupResults.length).toFixed(1);
    %>
      <div class="card mb-4">
        <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
          <span><i class="bi bi-calendar-range"></i> <%= termName %>, <%= sessionName %></span>
          <span class="badge bg-info" style="font-size: 0.75rem;">Avg: <%= groupAvg %>%</span>
        </div>
        <div class="card-body p-0">
          <div class="results-list">
            <% groupResults.forEach(function(r, idx) {
              var gradeColor = r.grade === 'A' ? '#10b981' : r.grade === 'B' ? '#3b82f6' : r.grade === 'C' ? '#f59e0b' : r.grade === 'D' ? '#f97316' : r.grade === 'E' ? '#ef4444' : '#dc2626';
              var maxScore = 100;
              var barWidth = Math.min(100, (r.total / maxScore) * 100);
              var isLast = idx === groupResults.length - 1;
            %>
              <div class="result-row <%= isLast ? '' : 'border-bottom' %>">
                <div class="result-row-inner">
                  <div class="result-subject">
                    <div class="result-subject-name"><%= r.subject_name %></div>
                    <div class="result-scores d-flex gap-3">
                      <span class="text-muted" style="font-size: 0.75rem;">CA: <%= r.ca_score %></span>
                      <span class="text-muted" style="font-size: 0.75rem;">Exam: <%= r.exam_score %></span>
                    </div>
                  </div>
                  <div class="result-grade-container">
                    <div class="d-flex align-items-center gap-2">
                      <span class="result-total"><%= r.total %></span>
                      <span class="badge result-grade-badge" style="background: <%= gradeColor %>;"><%= r.grade %></span>
                    </div>
                  </div>
                </div>
                <div class="result-bar-track">
                  <div class="result-bar-fill" style="width: <%= barWidth %>%; background: <%= gradeColor %>;"></div>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      </div>
    <% } %>

    <div class="text-center mb-4">
      <div class="d-flex flex-wrap justify-content-center gap-2">
        <a class="btn btn-success btn-lg" href="/student/results/download?session_id=<%= selectedSessionId %>&term_id=<%= selectedTermId %>">
          <i class="bi bi-download"></i> Download PDF Report
        </a>
        <button class="btn btn-primary btn-lg" onclick="requestResult()" id="requestBtn2">
          <i class="bi bi-envelope-paper"></i> Send to Email
        </button>
      </div>
      <p class="text-muted mt-2 mb-0" style="font-size: 0.8rem;">Download your official PDF report card or have it sent to your email.</p>
    </div>

  <% } else { %>
    <div class="card">
      <div class="card-body">
        <div class="text-center py-5">
          <div class="mb-3" style="font-size: 3.5rem; color: var(--text-muted);">
            <i class="bi bi-journal-text"></i>
          </div>
          <h5 class="text-muted mb-2">No Results Available</h5>
          <p class="text-muted mb-4" style="max-width: 400px; margin: 0 auto;">
            <% if (selectedTerm) { %>
              No approved results for <strong><%= selectedSession ? selectedSession.name : '' %></strong> - <strong><%= selectedTerm.name %></strong>.
            <% } else { %>
              Your approved results will appear here once your teacher uploads them and the admin approves.
            <% } %>
          </p>
          <% if (selectedTerm || selectedSession) { %>
            <a href="/student/results" class="btn btn-outline-secondary"><i class="bi bi-x-circle"></i> Clear Filters</a>
          <% } %>
        </div>
      </div>
    </div>
  <% } %>
</div>

<script>
function downloadResult() {
  var sessionEl = document.getElementById('session_id');
  var termEl = document.getElementById('term_id');
  var session_id = sessionEl.value;
  var term_id = termEl.value;
  if (!session_id) { showAlert('Please select a session first.'); return; }
  if (!term_id) {
    for (var i = 0; i < termEl.options.length; i++) {
      if (termEl.options[i].value) { term_id = termEl.options[i].value; break; }
    }
  }
  if (!term_id) { showAlert('No term available.'); return; }
  window.location.href = '/student/results/download?session_id=' + session_id + '&term_id=' + term_id;
}

async function requestResult() {
  var sessionEl = document.getElementById('session_id');
  var termEl = document.getElementById('term_id');
  var session_id = sessionEl.value;
  var term_id = termEl.value;

  if (!session_id) {
    showAlert('Please select a session first.');
    return;
  }
  if (!term_id) {
    for (var i = 0; i < termEl.options.length; i++) {
      if (termEl.options[i].value) { term_id = termEl.options[i].value; break; }
    }
  }
  if (!term_id) {
    showAlert('No term available. Please contact the admin.');
    return;
  }

  var buttons = document.querySelectorAll('[id^="requestBtn"]');
  buttons.forEach(function(b) {
    b.disabled = true;
    b.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Sending...';
  });

  var res = await fetch('/student/request-result', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ session_id: parseInt(session_id), term_id: parseInt(term_id) })
  });

  var data = await res.json();

  buttons.forEach(function(b) {
    b.disabled = false;
    b.innerHTML = '<i class="bi bi-envelope-paper"></i> Request Full Results via Email';
  });

  if (data.success) {
    showAlert('Result has been sent to your email.');
  } else {
    showAlert(data.message || 'Failed to send. Make sure you have set up your email in your profile.');
  }
}
</script>

<style>
.results-page .result-row {
  padding: 16px 20px;
  transition: background 0.2s ease;
}
.results-page .result-row:hover {
  background: rgba(59, 130, 246, 0.03);
}
.results-page .result-row-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}
.results-page .result-subject {
  flex: 1;
  min-width: 0;
}
.results-page .result-subject-name {
  font-weight: 600;
  font-size: 0.95rem;
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.results-page .result-total {
  font-weight: 700;
  font-size: 1.1rem;
  color: var(--text-primary);
}
.results-page .result-grade-badge {
  font-size: 0.85rem;
  padding: 4px 14px;
  border-radius: 20px;
  font-weight: 700;
  min-width: 36px;
  text-align: center;
}
.results-page .result-bar-track {
  height: 4px;
  background: var(--border-color);
  border-radius: 2px;
  margin-top: 10px;
  overflow: hidden;
}
.results-page .result-bar-fill {
  height: 100%;
  border-radius: 2px;
  transition: width 0.6s ease;
}
.results-page .stat-card.bg-purple {
  background: linear-gradient(135deg, #8b5cf6, #7c3aed);
}
@media (max-width: 575.98px) {
  .results-page .result-row {
    padding: 14px 14px;
  }
  .results-page .result-subject-name {
    font-size: 0.85rem;
  }
  .results-page .result-total {
    font-size: 1rem;
  }
  .results-page .result-grade-badge {
    font-size: 0.75rem;
    padding: 3px 10px;
    min-width: 30px;
  }
  .results-page .result-scores {
    gap: 8px !important;
  }
  .results-page .result-scores span {
    font-size: 0.7rem !important;
  }
}
</style>
