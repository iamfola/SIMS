<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof school !== 'undefined' ? school.school_name : 'SIMS' %> - Enter Passcode</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
  <style>
    :root {
      --primary: <%= typeof school !== 'undefined' ? school.primary_color : '#3b82f6' %>;
      --primary-dark: <%= typeof school !== 'undefined' ? school.primary_color : '#3b82f6' %>;
      --font-family: '<%= typeof school !== 'undefined' && school.font_family ? school.font_family : 'Inter' %>', 'Segoe UI', -apple-system, sans-serif;
    }
    body { background: var(--bg); font-family: var(--font-family); }
    .code-input { font-family: 'Courier New', monospace; font-size: 1.1rem; letter-spacing: 1px; }
  </style>
</head>
<body>
  <div class="login-container">
    <div class="login-card">
      <div class="login-logo">
        <% if (typeof school !== 'undefined' && school.logo_path) { %>
          <img src="<%= school.logo_path %>" alt="Logo" style="max-height: 60px; margin-bottom: 10px;">
        <% } else { %>
          <i class="bi bi-shield-lock"></i>
        <% } %>
        <h3>Password Reset</h3>
        <p>Enter the <%= typeof codeType !== 'undefined' && codeType === 'digits' ? '6-digit code' : '6-word passcode' %> sent to your email</p>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>
      <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success"><%= success %></div>
      <% } %>

      <% if (expired) { %>
        <div class="text-center">
          <p class="text-muted">This reset session has expired.</p>
          <a href="/forgot-password" class="btn btn-primary">Request New Passcode</a>
        </div>
      <% } else { %>
        <form method="POST" action="/enter-passcode">
          <div class="mb-3">
            <label class="form-label text-muted small">
              <i class="bi bi-envelope"></i> Code sent to <strong><%= maskedEmail %></strong>
            </label>
            <input type="text" class="form-control code-input" id="code" name="code"
              placeholder="<%= typeof codeType !== 'undefined' && codeType === 'digits' ? 'e.g. 284731' : 'e.g. abandon-ability-able-about-above-absent' %>" autofocus required>
            <div class="form-text"><%= typeof codeType !== 'undefined' && codeType === 'digits' ? 'Enter the 6-digit code from your email' : 'Paste the full 6-word passcode (hyphen-separated)' %></div>
          </div>
          <button type="submit" class="btn btn-primary w-100 mb-2">
            <i class="bi bi-shield-check"></i> Verify Passcode
          </button>
          <div class="text-center">
            <a href="/resend-passcode" class="text-decoration-none small">
              <i class="bi bi-arrow-clockwise"></i> Resend Code
            </a>
            <span class="mx-2 text-muted">|</span>
            <a href="/login" class="text-decoration-none small">
              <i class="bi bi-x-circle"></i> Cancel
            </a>
          </div>
        </form>
      <% } %>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>