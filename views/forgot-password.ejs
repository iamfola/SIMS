<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof school !== 'undefined' ? school.school_name : 'SIMS' %> - Forgot Password</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
  <style>
    :root {
      --primary: <%= typeof school !== 'undefined' ? school.primary_color : '#3b82f6' %>;
      --primary-dark: <%= typeof school !== 'undefined' ? school.primary_color : '#3b82f6' %>;
      --secondary: <%= typeof school !== 'undefined' ? school.secondary_color : '#8b5cf6' %>;
      --font-family: '<%= typeof school !== 'undefined' && school.font_family ? school.font_family : 'Inter' %>', 'Segoe UI', -apple-system, sans-serif;
    }
    body { background: var(--bg); font-family: var(--font-family); }
  </style>
</head>
<body>
  <div class="login-container">
    <div class="login-card">
      <div class="login-logo">
        <i class="bi bi-key"></i>
        <h3>Reset Password</h3>
        <p><%= typeof school !== 'undefined' ? school.school_name : 'SIMS' %> &mdash; Enter your username or Reg No to receive a passcode</p>
      </div>
            <% if (typeof error !== 'undefined' && error) { %>
              <div class="alert alert-danger"><%= error %></div>
            <% } %>
            <% if (typeof success !== 'undefined' && success) { %>
              <div class="alert alert-success"><%= success %></div>
              <% if (typeof showReset !== 'undefined' && showReset) { %>
                <a href="/reset-password?username=<%= typeof username !== 'undefined' ? username : '' %>" class="btn btn-primary w-100 mt-2">Enter Passcode</a>
              <% } %>
            <% } %>
            <% if (typeof showReset === 'undefined' || !showReset) { %>
            <form method="POST" action="/forgot-password">
              <div class="mb-3">
                <label for="username" class="form-label">Username or Reg No</label>
                <input type="text" class="form-control" id="username" name="username" placeholder="e.g. student.jss1.001 or JSS1/001" required autofocus>
              </div>
              <button type="submit" class="btn btn-primary w-100">Send Passcode</button>
            </form>
            <% } %>
            <div class="text-center mt-3">
              <a href="/login" class="text-decoration-none"><i class="bi bi-arrow-left"></i> Back to Login</a>
            </div>
      </div>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    (function() {
      var theme = localStorage.getItem('sims-theme');
      if (theme === 'dark') {
        document.documentElement.setAttribute('data-bs-theme', 'dark');
      }
    })();
  </script>
</body>
</html>